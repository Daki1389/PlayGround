{
  "name": "touchline-football-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Touchline '26 — a full-stack football manager game",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build --base ./",
    "start": "node server/index.js",
    "preview": "vite preview",
    "seed": "node server/seed-runner.js",
    "cap:sync": "npm run build && cap sync android",
    "android": "npm run cap:sync && cap open android",
    "android:build": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3",
    "@fontsource/barlow-condensed": "^5.1.1",
    "@fontsource/manrope": "^5.1.1",
    "express": "^4.21.2",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
